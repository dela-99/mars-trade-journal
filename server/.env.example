# Render API only. Use a durable PostgreSQL database shared by all devices.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Generate independently per installation: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Vercel frontend origin, with HTTPS in production (not the Render backend URL).
# Vercel proxies /api to Render; never put these secrets in frontend variables.
BETTER_AUTH_URL=http://localhost:3000
