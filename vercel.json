{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "pnpm run build:frontend",
  "outputDirectory": "frontend/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://replace-with-your-render-service.onrender.com/api/:path*"
    }
  ],
  "devCommand": "pnpm --filter @workspace/mars-trade-journal run dev --port $PORT"
}
